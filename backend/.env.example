# Copy this file to .env and fill in the values below. Never commit the real .env file.

# --- Database ---
# Local Postgres example: postgresql://username:password@localhost:5432/dip_kerala
# Supabase/Render will give you a connection string to paste here directly.
DATABASE_URL=postgresql://localhost/dip_kerala

# --- Google OAuth (for login) ---
# Get these from console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Project used elsewhere in this project: dip-kerala-502817
# Authorized redirect URI to register there: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT signing secret ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- NewsAPI (for the hourly Kerala disaster news feed) ---
# Free key from https://newsapi.org/register -- free tier: 100 requests/day (we use ~24/day)
NEWSAPI_KEY=

# --- URLs (defaults work for local development) ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
